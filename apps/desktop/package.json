{
  "name": "@forge/desktop",
  "private": true,
  "version": "1.0.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev":     "electron-vite dev",
    "build":   "electron-vite build",
    "dist":    "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "rebuild": "node -e \"const{execSync:e}=require('child_process'),s=require('path').resolve(__dirname,'../../node_modules/.pnpm'),p=s+'/prebuild-install@7.1.3/node_modules/prebuild-install/bin.js',d=s+'/better-sqlite3@11.10.0/node_modules/better-sqlite3';process.chdir(d);e('node '+JSON.stringify(p)+' --runtime=electron --target=31.7.7 --arch=x64',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@forge/db":       "workspace:*",
    "@forge/shared":   "workspace:*",
    "better-sqlite3":  "^11.10.0",
    "electron-log":    "^5.2.0",
    "electron-updater":"^6.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/electron":       "^1.6.0",
    "concurrently":          "^9.0.0",
    "electron":              "^31.0.0",
    "electron-builder":      "^24.13.0",
    "electron-vite":         "^2.3.0",
    "typescript":            "^5.4.0",
    "wait-on":               "^8.0.0"
  }
}
