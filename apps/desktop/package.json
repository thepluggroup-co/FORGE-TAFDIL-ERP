{
  "name": "@forge/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "FORGE ERP — TAFDIL SARL",
  "author": "TAFDIL SARL",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:full": "concurrently --kill-others --names \"WEB,ELECTRON\" --prefix-colors \"cyan,yellow\" \"pnpm --filter @forge/web dev\" \"wait-on http://localhost:5173 && electron-vite dev\"",
    "build": "electron-vite build",
    "dist": "pnpm --filter @forge/web build && electron-vite build && electron-builder",
    "dist:win": "pnpm --filter @forge/web build && electron-vite build && electron-builder --win --publish never",
    "dist:win:dir": "pnpm --filter @forge/web build && electron-vite build && electron-builder --win --config.win.target=dir",
    "rebuild": "node -e \"const{execSync:e}=require('child_process'),s=require('path').resolve(__dirname,'../../node_modules/.pnpm'),p=s+'/prebuild-install@7.1.3/node_modules/prebuild-install/bin.js',d=s+'/better-sqlite3@11.10.0/node_modules/better-sqlite3';process.chdir(d);e('node '+JSON.stringify(p)+' --runtime=electron --target=31.7.7 --arch=x64',{stdio:'inherit'})\"",
    "release:win": "pnpm --filter @forge/web build && electron-vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.tafdil.forge",
    "productName": "FORGE by TAFDIL",
    "copyright": "Copyright © 2026 TAFDIL SARL",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**",
      "!out/renderer/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/forge.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FORGE by TAFDIL",
      "installerIcon": "assets/forge.ico",
      "uninstallerIcon": "assets/forge.ico",
      "artifactName": "FORGE-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thepluggroup-co",
        "repo": "FORGE-TAFDIL-ERP",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/electron": "^1.6.0",
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
