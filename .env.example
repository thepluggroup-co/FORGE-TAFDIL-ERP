# ── Supabase (PostgreSQL cloud) ───────────────────────────────────────────────
SUPABASE_URL=https://lcfuuwwsfqdhphhsbkky.supabase.co
SUPABASE_ANON_KEY=eyJ...votre_anon_key...
SUPABASE_SERVICE_KEY=eyJ...votre_service_role_key...

# ── Authentification JWT ──────────────────────────────────────────────────────
# CRITIQUE : doit correspondre exactement au JWT secret de votre projet Supabase.
# Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=...votre_jwt_secret...

# ── IA ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Paiements NOKASH (Afrique) ──────────────────────────────────────────────
NOKASH_APPLICATION_KEY=
NOKASH_INTEGRATION_KEY=
NOKASH_CALLBACK_URL=

# ── URL publique de l'API utilisée par le shop ──────────────────────────────
FORGE_API_URL=https://forge-tafdil-erp-tafdil.up.railway.app
# ── Notifications WhatsApp (CallMeBot) ────────────────────────────────────────
CALLMEBOT_APIKEY=...
# Numéro WhatsApp du directeur pour les rapports automatiques (format E.164)
DIRECTEUR_WHATSAPP_PHONE=+237600000000

# ── Notifications SMS (Africa's Talking) ──────────────────────────────────────
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=...
# Sandbox : AFRICASTALKING. Production : vide tant qu'AT n'a pas approuvé de sender ID
AFRICASTALKING_SENDER_ID=AFRICASTALKING
AFRICASTALKING_ENV=sandbox
SMS_DEFAULT_COUNTRY_CODE=237

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS — origines autorisées ────────────────────────────────────────────────
FRONTEND_URL=https://forge-tafdil-erp-web.vercel.app
# FRONTEND_URL=https://forge-tafdil.vercel.app  # ancien domaine public
# TAURI_URL=tauri://localhost   # décommenter si app desktop Tauri active

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Invitations ERP (lien de l email d invitation / reinitialisation) ─────────
INVITE_REDIRECT_URL=https://forge-tafdil-erp-web.vercel.app

# ── Espace client du shop (API ET shop : meme valeur des deux cotes) ──────────
# Secret serveur a serveur : 32 caracteres aleatoires minimum, jamais cote navigateur
SHOP_API_SECRET=...secret_long_et_aleatoire...

# ── Shop uniquement : connexion Google / Facebook ─────────────────────────────
# URL de retour a declarer : <NEXT_PUBLIC_SITE_URL>/api/auth/shop/oauth/google/callback
#                            <NEXT_PUBLIC_SITE_URL>/api/auth/shop/oauth/facebook/callback
NEXT_PUBLIC_SITE_URL=https://shop.tafdil.cm
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
